[0m05:31:51.731469 [debug] [Thread-1 (]: On model.dbt_contadoria.slv_processos: /* {"app": "dbt", "dbt_version": "1.11.8", "profile_name": "contadoria_dw", "target_name": "dev", "node_id": "model.dbt_contadoria.slv_processos"} */

  
    

  create  table "postgres"."public_silver"."slv_processos__dbt_tmp"
  
  
    as
  
  (
    

WITH base_processos AS (
    SELECT * FROM "postgres"."bronze"."processes"
),
base_users AS (
    SELECT * FROM "postgres"."bronze"."users"
),
base_status AS (
    SELECT * FROM "postgres"."bronze"."status"
)

SELECT
    p.number AS processo_numero,
    p.entry_date AS data_remessa,
    u.nome AS calculista_nome,  -- Substituindo ID pelo Nome
    s.nome AS status_atual,
    
    -- Lógica da Coluna Meta
    CASE 
        WHEN s.nome IN (
            'Cálculo atualizado', 
            'Cálculo realizado', 
            'Devolvido: ausência de documentos para os cálculos', 
            'Devolvido: ausência de parâmetros', 
            'Devolvido: Beneficiário da Justiça Gratuita', 
            'Devolvido: Custas Satisfeitas', 
            'Devolvido: esclarecimento realizado', 
            'Partilha Realizada'
        ) THEN 1
        ELSE 0
    END AS meta,
    
    -- Cálculo de Dias Parado
    CURRENT_DATE - p.entry_date::date AS dias_parado,
    
    p.court AS vara,
    p.nucleus AS nucleo,
    p.priority AS prioridade,
    p.valor_custas,
    p.observacao,
    p.created_at

FROM base_processos p
LEFT JOIN base_users u ON p.user_id = u.id  -- Assumindo user_id na processes
LEFT JOIN base_status s ON p.status_id = s.id -- Assumindo status_id na processes
  );
  
