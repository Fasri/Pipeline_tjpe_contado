{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.11.8", "generated_at": "2026-05-20T08:32:54.506210Z", "invocation_id": "b6b9fb22-4849-4947-82a2-5fba2ddef89f", "invocation_started_at": "2026-05-20T08:32:28.586259Z", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-20T08:32:40.619433Z", "completed_at": "2026-05-20T08:32:40.634745Z"}, {"name": "execute", "started_at": "2026-05-20T08:32:40.636518Z", "completed_at": "2026-05-20T08:32:53.000017Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 12.38428521156311, "adapter_response": {"_message": "SELECT 201353", "code": "SELECT", "rows_affected": 201353}, "message": "SELECT 201353", "failures": null, "unique_id": "model.dbt_contadoria.slv_processos", "compiled": true, "compiled_code": "\n\nWITH base_processos AS (\n    SELECT * FROM \"postgres\".\"bronze\".\"processes\"\n),\nbase_users AS (\n    SELECT * FROM \"postgres\".\"bronze\".\"users\"\n),\nbase_status AS (\n    SELECT * FROM \"postgres\".\"bronze\".\"status\"\n)\n\nSELECT\n    p.position AS posicao,\n    p.priority_position AS posicao_prioridade,\n    p.number AS processo_numero,\n    p.entry_date AS data_remessa,\n    u.name AS Calculista,  -- Substituindo ID pelo Nome (coluna 'name' em users)\n    p.status AS status_atual,   -- Usando a coluna 'status' diretamente de processes\n    \n    -- L\u00f3gica da Coluna Meta\n    CASE \n        WHEN p.status IN (\n            'C\u00e1lculo atualizado', \n            'C\u00e1lculo realizado', \n            'Devolvido: aus\u00eancia de documentos para os c\u00e1lculos', \n            'Devolvido: aus\u00eancia de par\u00e2metros', \n            'Devolvido: Benefici\u00e1rio da Justi\u00e7a Gratuita', \n            'Devolvido: Custas Satisfeitas', \n            'Devolvido: esclarecimento realizado', \n            'Partilha Realizada'\n        ) THEN 1\n        ELSE 0\n    END AS meta,\n    \n    -- C\u00e1lculo de Dias Parado\n    CASE \n        WHEN p.status = 'Pendente' THEN CURRENT_DATE - p.entry_date::date\n        ELSE p.completion_date::date - p.entry_date::date\n    END AS dias_parado,\n    \n    p.court AS vara,\n    p.nucleus AS nucleo,\n    p.priority AS prioridade,\n    p.completion_date AS data_conclusao,\n    p.valor_custas,\n    p.observacao,\n    p.created_at\n\nFROM base_processos p\nLEFT JOIN base_users u ON p.assigned_to_id = u.id  -- Corrigido para assigned_to_id", "relation_name": "\"postgres\".\"public_silver\".\"slv_processos\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-20T08:32:53.013106Z", "completed_at": "2026-05-20T08:32:53.024933Z"}, {"name": "execute", "started_at": "2026-05-20T08:32:53.026884Z", "completed_at": "2026-05-20T08:32:54.039811Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 1.0305187702178955, "adapter_response": {"_message": "CREATE VIEW", "code": "CREATE VIEW", "rows_affected": -1}, "message": "CREATE VIEW", "failures": null, "unique_id": "model.dbt_contadoria.gld_processos_pendentes", "compiled": true, "compiled_code": "\n\nSELECT *\nFROM \"postgres\".\"public_silver\".\"slv_processos\"\nWHERE status_atual = 'Pendente'", "relation_name": "\"postgres\".\"public_gold\".\"gld_processos_pendentes\"", "batch_results": null}], "elapsed_time": 21.37626028060913, "args": {"use_colors": true, "invocation_command": "dbt run --profiles-dir dbt_contadoria --project-dir dbt_contadoria", "cache_selected_only": false, "upload_to_artifacts_ingest_api": false, "log_level_file": "debug", "state_modified_compare_vars": false, "partial_parse": true, "select": [], "strict_mode": false, "log_format": "default", "quiet": false, "log_format_file": "debug", "use_colors_file": true, "show_all_deprecations": false, "defer": false, "introspect": true, "write_json": true, "printer_width": 80, "project_dir": "dbt_contadoria", "favor_state": false, "require_all_warnings_handled_by_warn_erro